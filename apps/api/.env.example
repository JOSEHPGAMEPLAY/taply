# Database
# Get your DATABASE_URL from https://console.prisma.io/
DATABASE_URL="postgres://your-connection-string@db.prisma.io:5432/postgres?sslmode=require"

# Application
NODE_ENV=development
API_PORT=3001

# JWT
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRATION=15m
REFRESH_SECRET=your-refresh-secret-change-in-production
REFRESH_EXPIRATION=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Admin (create on first run)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Mail (nodemailer)
EMAIL_USER=
EMAIL_FROM=
