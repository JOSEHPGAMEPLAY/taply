# Database
# Prisma.io managed PostgreSQL database
# OBTÉN TU DATABASE_URL EN: https://prisma.io/data-platform
DATABASE_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"

# Application
NODE_ENV=development
API_PORT=3001

# JWT — Genera secretos seguros en producción:
#   openssl rand -base64 32
JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRATION=15m
REFRESH_SECRET=change-this-to-another-secure-random-string
REFRESH_EXPIRATION=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Admin (create on first run)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Mail (nodemailer)
EMAIL_USER=
EMAIL_FROM=
