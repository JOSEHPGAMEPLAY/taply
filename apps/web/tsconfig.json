{
  "extends": "@taply/typescript-config/tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2021",
    "module": "preserve",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "lib": [
      "ES2021",
      "DOM",
      "DOM.Iterable"
    ],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "allowJs": true,
    "isolatedModules": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
