# Node environment
NODE_ENV=development

# PostgreSQL
POSTGRES_DB=taply
POSTGRES_USER=taply_user
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# Database URL (use service name "postgres" inside Docker)
DATABASE_URL=postgresql://taply_user:change_me@postgres:5432/taply?schema=public

# API
API_PORT=3001

# Web
WEB_PORT=3000

# Internal API URL (server-side only, used by Next.js Server Components inside Docker)
# Inside Docker: use service name "api". Local dev: use "localhost".
API_INTERNAL_URL=http://localhost:3001/api/v1

# Next.js public variables (exposed to browser)
# Must be localhost because the browser resolves this, not the container
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# JWT Authentication
JWT_SECRET=change-me-to-a-random-secret-in-production
JWT_EXPIRATION=15m
REFRESH_SECRET=change-me-to-another-random-secret-in-production
REFRESH_EXPIRATION=7d

# CORS (multiple origins separated by comma for network access)
# Add your local network IP for mobile testing
CORS_ORIGIN=http://localhost:3000,http://YOUR_LOCAL_IP:3000

# Email (Gmail OAuth2)
# See docs: https://developers.google.com/gmail/api/quickstart/nodejs
# Create credentials at: https://console.cloud.google.com/
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_CLIENT_ID=
EMAIL_CLIENT_SECRET=
EMAIL_REFRESH_TOKEN=
EMAIL_FROM=Taply <your-email@gmail.com>

# Default Admin User (only created if both are set)
# Leave empty to skip admin creation
ADMIN_EMAIL=admin@taply.com
ADMIN_PASSWORD=Admin123
